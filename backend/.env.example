DB_URL=jdbc:postgresql://localhost:5432/dopapc
DB_USERNAME=dopapc_user
DB_PASSWORD=changeme_local

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_local
MINIO_BUCKET_PRODUCTS=products

ADMIN_IMPORT_TOKEN=changeme_admin_token
# Cambiar a true solo temporalmente para reimportar catálogo en un entorno nuevo/limpio
ADMIN_IMPORT_ENABLED=false

JWT_SECRET=changeme_generate_a_random_long_string_for_production
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

SHIPMENT_CHECK_INTERVAL_MS=10000
# Cada cuánto (ms) el scheduler revisa todos los shipments pendientes
SHIPMENT_THRESHOLD_PENDING_MS=30000
# Tiempo en PENDING antes de pasar a PREPARING (30s)
SHIPMENT_THRESHOLD_PREPARING_MS=600000
# Tiempo en PREPARING antes de pasar a SHIPPED (10 min)
SHIPMENT_THRESHOLD_SHIPPED_MS=86400000
# Tiempo en SHIPPED antes de pasar a DELIVERED (1 día)

# Opcionales (defaults seguros)
JPA_SHOW_SQL=false
SECURITY_LOG_LEVEL=INFO
